{
  "name": "stand-in-studio",
  "productName": "Stand-In Studio",
  "version": "0.0.0",
  "private": true,
  "description": "Decide how much of you each call sees: a presence dial from fully you to a hand-drawn stand-in, driven by Presage SmartSpectra signals.",
  "license": "MIT",
  "author": "Fayaz Ahmed <me@fayaz.dev>",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "start:nosandbox": "npm run build && electron . --no-sandbox",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "3.5.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "45.4.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
