{
  "name": "stand-in-studio",
  "productName": "Stand-In Studio",
  "version": "1.6.0",
  "private": true,
  "description": "Decide how much of you each call sees: a presence dial from fully you to a hand-drawn stand-in, driven by Presage SmartSpectra signals.",
  "license": "MIT",
  "author": "Fayaz Ahmed <me@fayaz.dev>",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "start:nosandbox": "npm run build && electron . --no-sandbox",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit",
    "test:e2e": "npm run build && xvfb-run -a playwright test --trace off",
    "test:live": "npm run build && xvfb-run -a node scripts/run-live.mjs live 60 960x540",
    "presage:budget": "node scripts/presage-budget.mjs"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "3.5.0",
    "koffi": "2.16.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "axe-core": "4.14.1",
    "electron": "45.4.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "fast-check": "4.10.3",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
